        System.out.print("Pehla number daalo: ");
        int a = sc.nextInt();
        
        System.out.print("Dusra number daalo: ");
        int b = sc.nextInt();
        
        int sum = a + b;
        System.out.println("Sum hai: " + sum);
    }
}
